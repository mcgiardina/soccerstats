SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable key lets --dry-run read published games without the service key.
SUPABASE_ANON_KEY=
# Service role key: server-side only. Never ship it to the browser or commit it.
SUPABASE_SERVICE_KEY=YOUR-SERVICE-ROLE-KEY
# Optional: path to Roboflow football-players-detection weights (player/goalkeeper/referee/ball).
# Without it the stock yolo11s COCO model is used: 'person' + 'sports ball' only, no keeper/ref filtering.
PLAYER_WEIGHTS=
# Optional: pitch keypoint model weights. Without it, homography and machine shot locations are skipped.
PITCH_WEIGHTS=
